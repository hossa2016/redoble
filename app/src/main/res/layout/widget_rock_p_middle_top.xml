<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/middle" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="10dp">
<LinearLayout android:id="@+id/player" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="top" android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:layout_marginTop="16dp" android:background="@drawable/bg_player" android:orientation="vertical" android:paddingStart="14dp" android:paddingTop="12dp" android:paddingEnd="14dp" android:paddingBottom="8dp" android:visibility="gone">
 <LinearLayout android:id="@+id/player_head" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
  <ImageView android:id="@+id/player_eq" android:layout_width="16dp" android:layout_height="14dp" android:layout_marginEnd="8dp" android:scaleType="fitCenter" android:contentDescription="@null" />
  <TextView android:id="@+id/player_src" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/anton_regular" android:textSize="12sp" android:textColor="#FFEDE6DC" android:maxLines="1" android:includeFontPadding="false" android:text="MÚSICA" android:letterSpacing="0.06" /><ImageView android:id="@+id/player_src_bmp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:adjustViewBounds="true" android:scaleType="fitStart" android:contentDescription="@null" android:visibility="gone" />
  <TextView android:id="@+id/player_state" android:layout_width="0dp" android:layout_height="wrap_content" android:fontFamily="@font/barlow_condensed_regular" android:textSize="13sp" android:textColor="#FFB5AA9F" android:maxLines="1" android:includeFontPadding="false" android:layout_weight="1" /><ImageView android:id="@+id/player_state_bmp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:adjustViewBounds="true" android:scaleType="fitStart" android:contentDescription="@null" android:visibility="gone" /><FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="0.01" />
  <ImageView android:id="@+id/player_close" android:foreground="@drawable/ripple_round_dark" android:layout_width="36dp" android:layout_height="28dp" android:layout_marginEnd="-8dp" android:contentDescription="Cerrar reproductor" android:paddingStart="10dp" android:paddingTop="6dp" android:paddingEnd="10dp" android:paddingBottom="6dp" android:scaleType="fitCenter" />
 </LinearLayout>
 <LinearLayout android:id="@+id/player_info" android:foreground="@drawable/ripple_box_dark" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal">
  <ImageView android:id="@+id/player_art" android:layout_width="56dp" android:layout_height="56dp" android:scaleType="fitCenter" android:contentDescription="Carátula" />
  <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
   <TextView android:id="@+id/player_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/barlow_condensed_semibold" android:textSize="20sp" android:textColor="#FFEDE6DC" android:maxLines="1" android:includeFontPadding="false" android:ellipsize="end" /><ImageView android:id="@+id/player_title_bmp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:adjustViewBounds="true" android:scaleType="fitStart" android:contentDescription="@null" android:visibility="gone" />
   <TextView android:id="@+id/player_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/barlow_condensed_regular" android:textSize="15sp" android:textColor="#FFB5AA9F" android:maxLines="1" android:includeFontPadding="false" android:layout_marginTop="3dp" android:ellipsize="end" /><ImageView android:id="@+id/player_artist_bmp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:adjustViewBounds="true" android:scaleType="fitStart" android:contentDescription="@null" android:visibility="gone" />
  </LinearLayout>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center" android:orientation="horizontal">
  <ImageView android:id="@+id/player_prev" android:foreground="@drawable/ripple_round_dark" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="Anterior" android:padding="13dp" android:scaleType="fitCenter" />
  <ImageView android:id="@+id/player_play" android:foreground="@drawable/ripple_round_dark" android:layout_width="52dp" android:layout_height="52dp" android:layout_marginStart="36dp" android:layout_marginEnd="36dp" android:scaleType="fitCenter" android:contentDescription="Reproducir" />
  <ImageView android:id="@+id/player_next" android:foreground="@drawable/ripple_round_dark" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="Siguiente" android:padding="13dp" android:scaleType="fitCenter" />
 </LinearLayout>
</LinearLayout>
<LinearLayout android:id="@+id/player_c" android:layout_width="match_parent" android:layout_height="64dp" android:layout_gravity="top" android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:layout_marginTop="16dp" android:background="@drawable/bg_player" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="10dp" android:paddingEnd="6dp" android:visibility="gone">
 <LinearLayout android:id="@+id/pc_info" android:foreground="@drawable/ripple_box_dark" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
  <ImageView android:id="@+id/pc_art" android:layout_width="46dp" android:layout_height="46dp" android:scaleType="fitCenter" android:contentDescription="Carátula" />
  <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
   <TextView android:id="@+id/pc_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/barlow_condensed_semibold" android:textSize="16sp" android:textColor="#FFEDE6DC" android:maxLines="1" android:includeFontPadding="false" android:ellipsize="end" /><ImageView android:id="@+id/pc_title_bmp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:adjustViewBounds="true" android:scaleType="fitStart" android:contentDescription="@null" android:visibility="gone" />
   <TextView android:id="@+id/pc_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/barlow_condensed_regular" android:textSize="13sp" android:textColor="#FFB5AA9F" android:maxLines="1" android:includeFontPadding="false" android:layout_marginTop="2dp" android:ellipsize="end" /><ImageView android:id="@+id/pc_artist_bmp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:adjustViewBounds="true" android:scaleType="fitStart" android:contentDescription="@null" android:visibility="gone" />
  </LinearLayout>
 </LinearLayout>
 <ImageView android:id="@+id/pc_play" android:foreground="@drawable/ripple_round_dark" android:layout_width="44dp" android:layout_height="44dp" android:padding="2dp" android:scaleType="fitCenter" android:contentDescription="Reproducir" />
 <ImageView android:id="@+id/pc_next" android:foreground="@drawable/ripple_round_dark" android:layout_width="44dp" android:layout_height="44dp" android:padding="12dp" android:scaleType="fitCenter" android:contentDescription="Siguiente" />
</LinearLayout>
</FrameLayout>

