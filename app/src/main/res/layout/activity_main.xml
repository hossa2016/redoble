<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0B0C"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-condensed"
            android:text="REDOBLE"
            android:textColor="#F1EFE8"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tu pantalla de inicio en modo rock"
            android:textColor="#888780"
            android:textSize="14sp" />

        <!-- Fondo -->
        <TextView
            style="@style/Section"
            android:text="FONDO DE PANTALLA" />

        <ImageView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="340dp"
            android:background="@drawable/field"
            android:contentDescription="Vista previa del fondo"
            android:scaleType="centerCrop" />

        <Button
            android:id="@+id/btnPick"
            style="@style/RockButton"
            android:text="Elegir foto de la galería" />

        <TextView
            android:id="@+id/dimLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Oscurecer: 40%"
            android:textColor="#D3D1C7"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/dim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:max="85" />

        <Button
            android:id="@+id/btnApply"
            style="@style/RockButton"
            android:text="Aplicar como fondo" />

        <!-- Color -->
        <TextView
            style="@style/Section"
            android:text="COLOR DE ACENTO" />

        <RadioGroup
            android:id="@+id/colors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/cRed"
                style="@style/RockRadio"
                android:text="Rojo" />

            <RadioButton
                android:id="@+id/cBlue"
                style="@style/RockRadio"
                android:text="Azul" />

            <RadioButton
                android:id="@+id/cSilver"
                style="@style/RockRadio"
                android:text="Plata" />
        </RadioGroup>

        <!-- Clima -->
        <TextView
            style="@style/Section"
            android:text="CLIMA" />

        <EditText
            android:id="@+id/city"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/field"
            android:hint="Tu ciudad, por ejemplo Bogotá"
            android:inputType="textCapWords"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="#F1EFE8"
            android:textColorHint="#5F5E5A" />

        <Button
            android:id="@+id/btnCity"
            style="@style/RockButton"
            android:text="Guardar ciudad" />

        <TextView
            android:id="@+id/cityStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#888780"
            android:textSize="13sp" />

        <!-- Apps -->
        <TextView
            style="@style/Section"
            android:text="APPS DEL WIDGET" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Toca cada espacio para elegir la app"
            android:textColor="#888780"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/slots"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btnWidget"
            style="@style/RockButton"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="40dp"
            android:text="Poner el widget en la pantalla" />
    </LinearLayout>
</ScrollView>
