<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/day_img"
            android:layout_width="72dp"
            android:layout_height="210dp"
            android:contentDescription="@null"
            android:scaleType="fitXY" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextClock
                    android:id="@+id/hh"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/barlow_condensed_extralight"
                    android:format12Hour="h"
                    android:format24Hour="H"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:shadowColor="#99000000"
                    android:shadowDy="4"
                    android:shadowRadius="16"
                    android:textColor="#FFEDE6DC"
                    android:textSize="70sp" />
                <TextView
                    android:id="@+id/colon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/barlow_condensed_light"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:paddingBottom="3dp"
                    android:text=":"
                    android:textColor="#FFE24B4A"
                    android:textSize="70sp" />
                <TextClock
                    android:id="@+id/mm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/barlow_condensed_extralight"
                    android:format12Hour="mm"
                    android:format24Hour="mm"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:shadowColor="#99000000"
                    android:shadowDy="4"
                    android:shadowRadius="16"
                    android:textColor="#FFEDE6DC"
                    android:textSize="70sp" />
            </LinearLayout>

            <TextClock
                android:id="@+id/date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/barlow_condensed_regular"
                android:format12Hour="d 'de' MMMM"
                android:format24Hour="d 'de' MMMM"
                android:maxLines="1"
                android:shadowColor="#CC000000"
                    android:shadowDy="2"
                    android:shadowRadius="6"
                android:textColor="#FFEDE6DC"
                android:textSize="18sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/hairline_row" />

            <TextView
                android:id="@+id/wx_now"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/barlow_condensed_medium"
                android:maxLines="1"
                android:shadowColor="#CC000000"
                    android:shadowDy="2"
                    android:shadowRadius="6"
                android:textColor="#FFEDE6DC"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/wx_tomorrow"
                android:layout_width="match_parent"
                android:autoSizeMaxTextSize="14sp"
                android:autoSizeMinTextSize="10sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:lines="1"
                android:layout_height="wrap_content"
                android:fontFamily="@font/barlow_condensed_light"
                android:shadowColor="#CC000000"
                    android:shadowDy="2"
                    android:shadowRadius="6"
                android:textColor="#FF9C9187"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/leds_img"
                    android:layout_width="113dp"
                    android:layout_height="19dp"
                    android:contentDescription="@null"
                    android:scaleType="fitXY" />
                <TextView
                    android:id="@+id/batt_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/barlow_condensed_medium"
                    android:maxLines="1"
                    android:shadowColor="#CC000000"
                    android:shadowDy="2"
                    android:shadowRadius="6"
                    android:textColor="#FFEDE6DC"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="10dp" />

    <LinearLayout
        android:id="@+id/setlist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="8dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/anton_regular"
                android:letterSpacing="0.06"
                android:shadowColor="#CC000000"
                    android:shadowDy="2"
                    android:shadowRadius="6"
                android:text="SETLIST"
                android:textColor="#FFEDE6DC"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/barlow_condensed_regular"
                android:textColor="#FF9C9187"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <FrameLayout
                android:id="@+id/pad0"
                android:layout_width="0dp"
                android:layout_height="74dp"
                android:layout_weight="1"
                
                android:background="@drawable/bg_pad">
                <TextView
                    android:id="@+id/num0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/barlow_condensed_medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="01"
                    android:textColor="#D9E24B4A"
                    android:textSize="11sp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="6dp">
                    <FrameLayout
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_icon_holder">
                        <ImageView
                            android:id="@+id/icon0"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null" />
                    </FrameLayout>
                    <TextView
                        android:id="@+id/label0"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/barlow_condensed_regular"
                        android:gravity="center"
                        android:maxLines="1"
                        android:textColor="#FFEDE6DC"
                        android:textSize="13sp" />
                </LinearLayout>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/pad1"
                android:layout_width="0dp"
                android:layout_height="74dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pad">
                <TextView
                    android:id="@+id/num1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/barlow_condensed_medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="02"
                    android:textColor="#D9E24B4A"
                    android:textSize="11sp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="6dp">
                    <FrameLayout
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_icon_holder">
                        <ImageView
                            android:id="@+id/icon1"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null" />
                    </FrameLayout>
                    <TextView
                        android:id="@+id/label1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/barlow_condensed_regular"
                        android:gravity="center"
                        android:maxLines="1"
                        android:textColor="#FFEDE6DC"
                        android:textSize="13sp" />
                </LinearLayout>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/pad2"
                android:layout_width="0dp"
                android:layout_height="74dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pad">
                <TextView
                    android:id="@+id/num2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/barlow_condensed_medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="03"
                    android:textColor="#D9E24B4A"
                    android:textSize="11sp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="6dp">
                    <FrameLayout
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_icon_holder">
                        <ImageView
                            android:id="@+id/icon2"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null" />
                    </FrameLayout>
                    <TextView
                        android:id="@+id/label2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/barlow_condensed_regular"
                        android:gravity="center"
                        android:maxLines="1"
                        android:textColor="#FFEDE6DC"
                        android:textSize="13sp" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <FrameLayout
                android:id="@+id/pad3"
                android:layout_width="0dp"
                android:layout_height="74dp"
                android:layout_weight="1"
                
                android:background="@drawable/bg_pad">
                <TextView
                    android:id="@+id/num3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/barlow_condensed_medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="04"
                    android:textColor="#D9E24B4A"
                    android:textSize="11sp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="6dp">
                    <FrameLayout
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_icon_holder">
                        <ImageView
                            android:id="@+id/icon3"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null" />
                    </FrameLayout>
                    <TextView
                        android:id="@+id/label3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/barlow_condensed_regular"
                        android:gravity="center"
                        android:maxLines="1"
                        android:textColor="#FFEDE6DC"
                        android:textSize="13sp" />
                </LinearLayout>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/pad4"
                android:layout_width="0dp"
                android:layout_height="74dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pad">
                <TextView
                    android:id="@+id/num4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/barlow_condensed_medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="05"
                    android:textColor="#D9E24B4A"
                    android:textSize="11sp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="6dp">
                    <FrameLayout
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_icon_holder">
                        <ImageView
                            android:id="@+id/icon4"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null" />
                    </FrameLayout>
                    <TextView
                        android:id="@+id/label4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/barlow_condensed_regular"
                        android:gravity="center"
                        android:maxLines="1"
                        android:textColor="#FFEDE6DC"
                        android:textSize="13sp" />
                </LinearLayout>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/pad5"
                android:layout_width="0dp"
                android:layout_height="74dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pad">
                <TextView
                    android:id="@+id/num5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/barlow_condensed_medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="06"
                    android:textColor="#D9E24B4A"
                    android:textSize="11sp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="6dp">
                    <FrameLayout
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_icon_holder">
                        <ImageView
                            android:id="@+id/icon5"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null" />
                    </FrameLayout>
                    <TextView
                        android:id="@+id/label5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/barlow_condensed_regular"
                        android:gravity="center"
                        android:maxLines="1"
                        android:textColor="#FFEDE6DC"
                        android:textSize="13sp" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="74dp"
            android:background="@drawable/bg_pad"
            android:gravity="center"
            android:visibility="gone">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/barlow_condensed_regular"
                android:text="Toca para elegir tus apps"
                android:textColor="#FF9C9187"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
