<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/day_img"
            android:layout_width="106dp"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitStart" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp">

            <LinearLayout
                android:id="@+id/header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:orientation="horizontal">

                    <TextClock
                        android:id="@+id/hh"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/barlow_condensed_extralight"
                        android:format12Hour="h"
                        android:format24Hour="H"
                        android:includeFontPadding="false"
                        android:letterSpacing="-0.01"
                        android:shadowColor="#99000000"
                        android:shadowDy="6"
                        android:shadowRadius="24"
                        android:textColor="#FFEDE6DC"
                        android:textSize="92sp" />

                    <TextView
                        android:id="@+id/colon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:fontFamily="@font/barlow_condensed_light"
                        android:includeFontPadding="false"
                        android:paddingBottom="4dp"
                        android:text=":"
                        android:textColor="#FFE24B4A"
                        android:textSize="92sp" />

                    <TextClock
                        android:id="@+id/mm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/barlow_condensed_extralight"
                        android:format12Hour="mm"
                        android:format24Hour="mm"
                        android:includeFontPadding="false"
                        android:letterSpacing="-0.01"
                        android:shadowColor="#99000000"
                        android:shadowDy="6"
                        android:shadowRadius="24"
                        android:textColor="#FFEDE6DC"
                        android:textSize="92sp" />
                </LinearLayout>

                <TextClock
                    android:id="@+id/date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/barlow_condensed_regular"
                    android:format12Hour="d 'de' MMMM"
                    android:format24Hour="d 'de' MMMM"
                    android:letterSpacing="0.01"
                    android:shadowColor="#CC000000"
                    android:shadowDy="2"
                    android:shadowRadius="6"
                    android:textColor="#FFEDE6DC"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/wx_now"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/barlow_condensed_medium"
                    android:shadowColor="#CC000000"
                    android:shadowDy="2"
                    android:shadowRadius="6"
                    android:textColor="#FFEDE6DC"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/wx_tomorrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/barlow_condensed_light"
                    android:maxLines="1"
                    android:shadowColor="#CC000000"
                    android:shadowDy="2"
                    android:shadowRadius="6"
                    android:textColor="#FF9C9187"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/leds_img"
                        android:layout_width="113dp"
                        android:layout_height="19dp"
                        android:contentDescription="@null"
                        android:scaleType="fitXY" />

                    <TextView
                        android:id="@+id/batt_txt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:fontFamily="@font/barlow_condensed_medium"
                        android:letterSpacing="0.02"
                        android:shadowColor="#CC000000"
                        android:shadowDy="2"
                        android:shadowRadius="6"
                        android:textColor="#FFEDE6DC"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="12dp" />

            <LinearLayout
                android:id="@+id/setlist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_setlist"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="6dp"
                android:paddingBottom="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingEnd="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/anton_regular"
                        android:letterSpacing="0.06"
                        android:text="SETLIST"
                        android:textColor="#FFEDE6DC"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/barlow_condensed_regular"
                        android:textColor="#FF645A52"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tracks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/hairline_row"
                    android:orientation="vertical"
                    android:showDividers="middle">

            <LinearLayout
                android:id="@+id/track0"
                android:layout_width="match_parent"
                android:layout_height="41dp"
                android:background="@drawable/track_ripple"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingEnd="8dp">
                <TextView
                    android:id="@+id/num0"
                    android:layout_width="16dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/barlow_condensed_medium"
                    android:text="01"
                    android:textColor="#D9E24B4A"
                    android:textSize="12sp" />
                <FrameLayout
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_icon_holder">
                    <ImageView
                        android:id="@+id/icon0"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null" />
                </FrameLayout>
                <TextView
                    android:id="@+id/label0"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/barlow_condensed_regular"
                    android:maxLines="1"
                    android:textColor="#FFEDE6DC"
                    android:textSize="17sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/track1"
                android:layout_width="match_parent"
                android:layout_height="41dp"
                android:background="@drawable/track_ripple"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingEnd="8dp">
                <TextView
                    android:id="@+id/num1"
                    android:layout_width="16dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/barlow_condensed_medium"
                    android:text="02"
                    android:textColor="#D9E24B4A"
                    android:textSize="12sp" />
                <FrameLayout
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_icon_holder">
                    <ImageView
                        android:id="@+id/icon1"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null" />
                </FrameLayout>
                <TextView
                    android:id="@+id/label1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/barlow_condensed_regular"
                    android:maxLines="1"
                    android:textColor="#FFEDE6DC"
                    android:textSize="17sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/track2"
                android:layout_width="match_parent"
                android:layout_height="41dp"
                android:background="@drawable/track_ripple"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingEnd="8dp">
                <TextView
                    android:id="@+id/num2"
                    android:layout_width="16dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/barlow_condensed_medium"
                    android:text="03"
                    android:textColor="#D9E24B4A"
                    android:textSize="12sp" />
                <FrameLayout
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_icon_holder">
                    <ImageView
                        android:id="@+id/icon2"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null" />
                </FrameLayout>
                <TextView
                    android:id="@+id/label2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/barlow_condensed_regular"
                    android:maxLines="1"
                    android:textColor="#FFEDE6DC"
                    android:textSize="17sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/track3"
                android:layout_width="match_parent"
                android:layout_height="41dp"
                android:background="@drawable/track_ripple"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingEnd="8dp">
                <TextView
                    android:id="@+id/num3"
                    android:layout_width="16dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/barlow_condensed_medium"
                    android:text="04"
                    android:textColor="#D9E24B4A"
                    android:textSize="12sp" />
                <FrameLayout
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_icon_holder">
                    <ImageView
                        android:id="@+id/icon3"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null" />
                </FrameLayout>
                <TextView
                    android:id="@+id/label3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/barlow_condensed_regular"
                    android:maxLines="1"
                    android:textColor="#FFEDE6DC"
                    android:textSize="17sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/track4"
                android:layout_width="match_parent"
                android:layout_height="41dp"
                android:background="@drawable/track_ripple"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingEnd="8dp">
                <TextView
                    android:id="@+id/num4"
                    android:layout_width="16dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/barlow_condensed_medium"
                    android:text="05"
                    android:textColor="#D9E24B4A"
                    android:textSize="12sp" />
                <FrameLayout
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_icon_holder">
                    <ImageView
                        android:id="@+id/icon4"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null" />
                </FrameLayout>
                <TextView
                    android:id="@+id/label4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/barlow_condensed_regular"
                    android:maxLines="1"
                    android:textColor="#FFEDE6DC"
                    android:textSize="17sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/track5"
                android:layout_width="match_parent"
                android:layout_height="41dp"
                android:background="@drawable/track_ripple"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingEnd="8dp">
                <TextView
                    android:id="@+id/num5"
                    android:layout_width="16dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/barlow_condensed_medium"
                    android:text="06"
                    android:textColor="#D9E24B4A"
                    android:textSize="12sp" />
                <FrameLayout
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_icon_holder">
                    <ImageView
                        android:id="@+id/icon5"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null" />
                </FrameLayout>
                <TextView
                    android:id="@+id/label5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/barlow_condensed_regular"
                    android:maxLines="1"
                    android:textColor="#FFEDE6DC"
                    android:textSize="17sp" />
            </LinearLayout>

                    <LinearLayout
                        android:id="@+id/empty"
                        android:layout_width="match_parent"
                        android:layout_height="41dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/barlow_condensed_regular"
                            android:text="Toca para elegir tus apps"
                            android:textColor="#FF9C9187"
                            android:textSize="17sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
