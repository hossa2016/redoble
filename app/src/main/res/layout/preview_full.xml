<?xml version="1.0" encoding="utf-8"?>
<!-- Vista en la lista de widgets del teléfono: el Completo con datos de ejemplo -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="8dp">
        <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:format12Hour="EEEE" android:format24Hour="EEEE" android:textAllCaps="true"
            android:fontFamily="@font/anton_regular" android:textSize="13sp" android:letterSpacing="0.06" android:textColor="#FFD2483F" />
        <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:format12Hour="h:mm" android:format24Hour="H:mm" android:includeFontPadding="false"
            android:fontFamily="@font/barlow_condensed_extralight" android:textSize="64sp" android:textColor="#FFEDE6DC" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:format12Hour="d 'de' MMMM" android:format24Hour="d 'de' MMMM" android:singleLine="true"
                android:fontFamily="@font/barlow_condensed_regular" android:textSize="16sp" android:textColor="#FFEDE6DC" />
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/pv_cloud" android:tint="#FFB5AA9F" android:scaleType="fitCenter" android:layout_marginStart="12dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp"
                android:text="21°" android:fontFamily="@font/barlow_condensed_medium" android:textSize="16sp" android:textColor="#FFB5AA9F" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
        android:background="@drawable/bg_player" android:gravity="center_vertical" android:orientation="horizontal" android:padding="10dp">
        <FrameLayout android:layout_width="46dp" android:layout_height="46dp" android:background="@drawable/pv_art">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/pv_music" android:tint="#CCFFFFFF" android:scaleType="fitCenter" android:layout_gravity="center"/>
        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tu canción"
                android:fontFamily="@font/barlow_condensed_semibold" android:textSize="15sp" android:textColor="#FFEDE6DC" android:singleLine="true" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tu artista"
                android:fontFamily="@font/barlow_condensed_regular" android:textSize="12sp" android:textColor="#FFB5AA9F" android:singleLine="true" />
        </LinearLayout>
        <FrameLayout android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/pv_play_bg">
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/pv_play" android:tint="#FFFFFFFF" android:scaleType="fitCenter" android:layout_gravity="center"/>
        </FrameLayout>
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/pv_next" android:tint="#FFEDE6DC" android:scaleType="fitCenter" android:layout_marginStart="12dp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal"><LinearLayout android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:background="@drawable/bg_pad" android:gravity="center" android:orientation="vertical">
  <FrameLayout android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/bg_icon_holder"><ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/pv_phone" android:tint="#FFEDE6DC" android:scaleType="fitCenter" android:layout_gravity="center"/></FrameLayout>
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Teléfono" android:fontFamily="@font/barlow_condensed_regular" android:textSize="12sp" android:textColor="#FFEDE6DC" android:singleLine="true" />
</LinearLayout><LinearLayout android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:layout_marginStart="8dp" android:background="@drawable/bg_pad" android:gravity="center" android:orientation="vertical">
  <FrameLayout android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/bg_icon_holder"><ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/pv_chat" android:tint="#FFEDE6DC" android:scaleType="fitCenter" android:layout_gravity="center"/></FrameLayout>
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Mensajes" android:fontFamily="@font/barlow_condensed_regular" android:textSize="12sp" android:textColor="#FFEDE6DC" android:singleLine="true" />
</LinearLayout><LinearLayout android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:layout_marginStart="8dp" android:background="@drawable/bg_pad" android:gravity="center" android:orientation="vertical">
  <FrameLayout android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/bg_icon_holder"><ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/pv_camera" android:tint="#FFEDE6DC" android:scaleType="fitCenter" android:layout_gravity="center"/></FrameLayout>
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Cámara" android:fontFamily="@font/barlow_condensed_regular" android:textSize="12sp" android:textColor="#FFEDE6DC" android:singleLine="true" />
</LinearLayout><LinearLayout android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:layout_marginStart="8dp" android:background="@drawable/bg_pad" android:gravity="center" android:orientation="vertical">
  <FrameLayout android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/bg_icon_holder"><ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/pv_music" android:tint="#FFEDE6DC" android:scaleType="fitCenter" android:layout_gravity="center"/></FrameLayout>
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Música" android:fontFamily="@font/barlow_condensed_regular" android:textSize="12sp" android:textColor="#FFEDE6DC" android:singleLine="true" />
</LinearLayout></LinearLayout>
</LinearLayout>
