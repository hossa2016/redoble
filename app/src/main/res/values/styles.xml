<resources>
    <style name="Section">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">30dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textColor">#E24B4A</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="RockButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:background">@drawable/field</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#F1EFE8</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="RockRadio">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">#D3D1C7</item>
        <item name="android:buttonTint">#E24B4A</item>
    </style>
</resources>
