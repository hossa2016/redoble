<resources>
    <style name="Theme.Redoble" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">#E24B4A</item>
        <item name="colorPrimaryDark">#0E0B09</item>
        <item name="colorAccent">#E24B4A</item>
        <item name="android:windowBackground">#FF0E0B09</item>
        <item name="android:statusBarColor">#FF0E0B09</item>
        <item name="android:navigationBarColor">#FF0E0B09</item>
        <item name="android:fontFamily">@font/barlow_regular</item>
    </style>
    <style name="Theme.Redoble.Sheet" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.72</item>
    </style>
</resources>
