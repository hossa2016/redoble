<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: copia en la nube y paso a un teléfono nuevo -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="redoble.xml" />
        <include domain="file" path="fondo.jpg" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="redoble.xml" />
        <include domain="file" path="fondo.jpg" />
        <!-- Al pasar a un teléfono nuevo (cable o Wi-Fi directo) también viajan los fondos descargados -->
        <include domain="file" path="videos/" />
    </device-transfer>
</data-extraction-rules>
