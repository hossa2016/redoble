<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient android:angle="270" android:startColor="#CC201914" android:endColor="#BD0E0B09" />
            <stroke android:width="1dp" android:color="#14FFFFFF" />
        </shape>
    </item>
    <item android:gravity="top" android:height="1dp" android:left="16dp" android:right="16dp">
        <shape android:shape="rectangle"><solid android:color="#1AFFFFFF" /></shape>
    </item>
</layer-list>
