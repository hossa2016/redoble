<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#E62A231E" />
            <stroke android:width="1dp" android:color="#24FFFFFF" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <gradient android:angle="270" android:startColor="#D11F1915" android:endColor="#C2120F0C" />
                    <stroke android:width="1dp" android:color="#17FFFFFF" />
                </shape>
            </item>
            <item android:gravity="top" android:height="1dp" android:left="14dp" android:right="14dp">
                <shape android:shape="rectangle"><solid android:color="#14FFFFFF" /></shape>
            </item>
        </layer-list>
    </item>
</selector>
