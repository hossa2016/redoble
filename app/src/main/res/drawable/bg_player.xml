<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient android:angle="270" android:startColor="#DB1F1915" android:endColor="#CC120F0C" />
            <stroke android:width="1dp" android:color="#1AFFFFFF" />
        </shape>
    </item>
    <item android:gravity="top" android:height="1dp" android:left="18dp" android:right="18dp">
        <shape android:shape="rectangle"><solid android:color="#14FFFFFF" /></shape>
    </item>
</layer-list>
